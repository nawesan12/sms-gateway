generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// USERS
// =============================================================================
model User {
  id                  String             @id @default(uuid())
  phoneE164           String             @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  lastLoginAt         DateTime?
  isBlocked           Boolean            @default(false)
  role                UserRole           @default(USER)
  accessTokenHash     String?            @unique
  accessTokenIssuedAt DateTime?
  otpRequests         OtpRequest[]
  tokenBalance        TokenBalance?
  tokenTransactions   TokenTransaction[]
  campaigns           Campaign[]

  @@index([phoneE164])
  @@index([role])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

// =============================================================================
// OTP REQUESTS
// =============================================================================
model OtpRequest {
  id          String      @id @default(uuid())
  userId      String?
  phoneE164   String
  codeHash    String
  attempts    Int         @default(0)
  maxAttempts Int         @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime    @default(now())
  ipAddress   String?
  userAgent   String?
  smsMessage  SmsMessage?
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phoneE164, createdAt])
  @@index([expiresAt])
  @@index([consumedAt])
  @@map("otp_requests")
}

// =============================================================================
// SMS MESSAGES
// =============================================================================
model SmsMessage {
  id                 String            @id @default(uuid())
  otpRequestId       String?           @unique
  deviceId           String
  recipientE164      String
  status             SmsStatus         @default(PENDING)
  textbeeMessageId   String?
  errorCode          String?
  errorMessage       String?
  sentAt             DateTime?
  deliveredAt        DateTime?
  failedAt           DateTime?
  retryCount         Int               @default(0)
  tokensCost         Int               @default(1)
  tokenTransactionId String?           @unique
  createdAt          DateTime          @default(now())
  device             Device            @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  otpRequest         OtpRequest?       @relation(fields: [otpRequestId], references: [id], onDelete: SetNull)
  tokenTransaction   TokenTransaction? @relation("SmsToReservation", fields: [tokenTransactionId], references: [id], onDelete: SetNull)
  tokenTransactions  TokenTransaction[] @relation("SmsToTransactions")

  @@index([deviceId, status])
  @@index([recipientE164])
  @@index([status, createdAt])
  @@map("sms_messages")
}

enum SmsStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  RETRYING
}

// =============================================================================
// DEVICES
// =============================================================================
model Device {
  id                String       @id @default(uuid())
  name              String
  // textbeeDeviceId queda por compat: ahora vale lo mismo que `id`. Se llena
  // en el create con el mismo UUID y se mantiene UNIQUE para no romper
  // queries existentes.
  textbeeDeviceId   String       @unique
  // Hash HMAC-SHA256 de la apiKey en plaintext (lookup O(1) cuando la app
  // Android se autentica con header x-api-key). La apiKey en plaintext solo
  // existe en la response del create — nunca se persiste.
  apiKeyHash        String?      @unique
  // Legacy: campo viejo que cifraba la apiKey emitida por TextBee. Ya no
  // aplica con FCM directo. Queda nullable para no romper migración auto.
  apiKeyEncrypted   String?
  // Token FCM del celular. Lo registra/refresca la app Android via
  // POST /v1/gateway/devices/:id/register.
  fcmToken          String?
  priority          Int          @default(100)
  status            DeviceStatus @default(ACTIVE)
  batteryLevel      Int?
  lastHeartbeat     DateTime?
  failureCount      Int          @default(0)
  circuitState      CircuitState @default(CLOSED)
  circuitOpenedAt   DateTime?
  minDelayBetweenMs Int          @default(0)
  // Cooldown lock entre envíos consecutivos al mismo device. Si está en el
  // futuro, el router skipea este device hasta que pase. Reemplazo del lock
  // distribuido en Redis (SET NX PX) por una columna versionada en Postgres.
  cooldownUntil     DateTime?
  // Flag que setea el watchdog cuando detecta que los últimos N SMS del
  // device están en SENT > 10 min sin pasar a DELIVERED. Sospecha que la
  // SIM está bloqueada por la operadora. El router lo skipea hasta que el
  // operador lo limpia desde la UI.
  suspectedBlocked  Boolean      @default(false)
  suspectedBlockedAt DateTime?
  suspectedBlockedReason String?
  // Contador rotatorio para round-robin: cantidad de SMS asignados por el
  // router en el día actual. Se usa para elegir siempre el device con menor
  // carga, evitando quemar una sola SIM.
  routerLoadCount   Int          @default(0)
  routerLoadResetAt DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  smsMessages       SmsMessage[]

  @@index([status, priority])
  @@map("devices")
}

enum DeviceStatus {
  ACTIVE
  INACTIVE
  OFFLINE
}

enum CircuitState {
  CLOSED
  OPEN
  HALF_OPEN
}

// =============================================================================
// AUDIT LOGS
// =============================================================================
model AuditLog {
  id            String   @id @default(uuid())
  eventType     String
  actorType     String
  actorId       String?
  targetType    String?
  targetId      String?
  metadata      Json?
  ipAddress     String?
  correlationId String?
  createdAt     DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([actorId])
  @@index([targetId])
  @@map("audit_logs")
}

// =============================================================================
// BLACKLIST
// =============================================================================
model Blacklist {
  id        String        @id @default(uuid())
  type      BlacklistType
  value     String
  reason    String?
  createdAt DateTime      @default(now())
  expiresAt DateTime?

  @@unique([type, value])
  @@index([type, value])
  @@map("blacklists")
}

enum BlacklistType {
  PHONE
  IP
  DEVICE
}

// =============================================================================
// CONTACTS
// =============================================================================
model Contact {
  id         String              @id @default(uuid())
  phoneE164  String              @unique
  name       String?
  email      String?
  metadata   Json?
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  lists      ContactListMember[]
  deliveries CampaignDelivery[]

  @@index([phoneE164])
  @@index([isActive])
  @@map("contacts")
}

model ContactList {
  id          String              @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  members     ContactListMember[]
  campaigns   Campaign[]

  @@index([name])
  @@map("contact_lists")
}

model ContactListMember {
  contactId String
  listId    String
  addedAt   DateTime    @default(now())
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@id([contactId, listId])
  @@index([listId])
  @@map("contact_list_members")
}

// =============================================================================
// CAMPAIGNS
// =============================================================================
model Campaign {
  id                 String             @id @default(uuid())
  name               String
  messageTemplate    String
  listId             String
  ownerUserId        String?
  status             CampaignStatus     @default(DRAFT)
  totalRecipients    Int                @default(0)
  sentCount          Int                @default(0)
  failedCount        Int                @default(0)
  tpsLimit           Int                @default(1)
  // Throughput por hora. Reemplaza al `tpsLimit` (queda por compat).
  // Default 60/hora = 1 mensaje cada 60 segundos. Más conservador que
  // 100/hora para evitar gatillar anti-spam de operadoras AR.
  messagesPerHour    Int                @default(60)
  // Se setea la primera vez que la campaña cruza el 50% de progreso.
  // Evita loguear el evento "halfway" en cada tick del watchdog.
  halfwayNotifiedAt  DateTime?
  launchedAt         DateTime?
  completedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  list               ContactList        @relation(fields: [listId], references: [id], onDelete: Restrict)
  ownerUser          User?              @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  deliveries         CampaignDelivery[]

  @@index([status, createdAt])
  @@index([ownerUserId])
  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELED
}

model CampaignDelivery {
  id           String         @id @default(uuid())
  campaignId   String
  contactId    String
  smsMessageId String?
  deviceId     String?
  status       DeliveryStatus @default(PENDING)
  errorCode    String?
  errorMessage String?
  sentAt       DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime       @default(now())
  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([smsMessageId])
  @@map("campaign_deliveries")
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

// =============================================================================
// TOKEN BALANCE (1 fila por User/cliente — multi-tenant)
// =============================================================================
model TokenBalance {
  userId    String   @id
  amount    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("token_balance")
}

model TokenTransaction {
  id            String                 @id @default(uuid())
  userId        String
  type          TokenTransactionType
  status        TokenTransactionStatus @default(RESERVED)
  amount        Int
  balanceAfter  Int
  smsMessageId  String?
  reason        String?
  actorType     String?
  actorId       String?
  correlationId String?
  metadata      Json?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  user                 User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  smsMessage           SmsMessage? @relation("SmsToTransactions", fields: [smsMessageId], references: [id], onDelete: SetNull)
  reservedBySmsMessage SmsMessage? @relation("SmsToReservation")

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([smsMessageId])
  @@map("token_transactions")
}

enum TokenTransactionType {
  PURCHASE
  RESERVATION
  COMMIT
  REFUND
  ADJUSTMENT
}

enum TokenTransactionStatus {
  RESERVED
  COMMITTED
  REFUNDED
}

// =============================================================================
// JOB QUEUE — reemplazo de BullMQ/Redis con polling en Postgres.
//
// Un único proceso Node atiende todo el laburo, así que no necesitamos
// distributed queue: bastan una tabla, FOR UPDATE SKIP LOCKED y polling.
// =============================================================================
model Job {
  id          String    @id @default(uuid())
  // 'sms.send' | 'campaign.send' | 'device.health' | 'sms.dlq'
  queue       String
  // Payload serializado. Cada worker conoce la forma para su queue.
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(4)
  // Cuándo puede correrse próximamente. Para retries con backoff
  // exponencial el worker setea nextRunAt = now + delay.
  nextRunAt   DateTime  @default(now())
  // Filtra el SKIP LOCKED: solo el worker que tomó el job lo ve corriendo.
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([queue, status, nextRunAt])
  @@index([status, updatedAt])
  @@map("jobs")
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  DEAD
}
