# =========================================================================
# SMS Gateway — variables de entorno
#
# Copiar a .env para correr local, o copiar las marcadas más abajo al
# dashboard de Render para producción.
#
# ⚠️  LOS SECRETS DE ESTE ARCHIVO ESTÁN COMMITEADOS AL REPO (público).
# Sirven como "starter pack" para deployar rápido, pero ANTES de tener
# usuarios reales hay que regenerarlos:
#   - JWT_PRIVATE_KEY_B64 / JWT_PUBLIC_KEY_B64
#   - MASTER_ENCRYPTION_KEY_B64  (rotarla implica re-cifrar API keys de devices)
#   - ADMIN_BOOTSTRAP_TOKEN
# Comandos abajo en cada bloque.
# =========================================================================

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
HOST=0.0.0.0

# --- Postgres (Neon, producción) ---
DATABASE_URL=postgresql://neondb_owner:npg_2GuLysI6HMeY@ep-snowy-silence-acqgdasm-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Redis (Upstash, producción) ---
REDIS_URL=rediss://default:gQAAAAAAAcgpAAIgcDExMGUwOGUzZDFlZTM0MGQyOGMyODMwNjAwYjNjZGU4OA@precise-lacewing-116777.upstash.io:6379

# --- JWT (RS256) ---
# Generar con:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Luego pasar a base64 single-line: base64 -i private.pem | tr -d '\n'
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
JWT_ISSUER=sms-gateway
JWT_AUDIENCE=sms-gateway-clients

# --- Cifrado de API keys de devices (AES-256-GCM) ---
# 32 bytes en base64. Generar con:
#   openssl rand -base64 32
MASTER_ENCRYPTION_KEY_B64=

# --- Admin bootstrap ---
# Token de un solo uso para crear el primer admin via /v1/admin/bootstrap
ADMIN_BOOTSTRAP_TOKEN=change-me-once

# Teléfono E.164 del admin operador. Se crea/promueve automáticamente en
# cada boot del proceso (ver src/bootstrap/seed-admin.ts), idempotente.
BOOTSTRAP_ADMIN_PHONE=+5491100000001

# --- Swagger UI ---
# /docs queda abierto en dev por default y cerrado en producción.
# Setear true para forzar abrirlo en producción (útil para demos).
# SWAGGER_UI_ENABLED=true

# --- Provider de SMS por celular ---
# El gateway upstream que efectivamente habla con los celulares (FCM → device).
# Apuntar a la instancia self-hosted nuestra:
#   https://crispy-palm-tree-tj4o.onrender.com/api/v1/gateway
# Mantener `/api/v1/gateway` al final (es el path del controller upstream).
TEXTBEE_BASE_URL=https://crispy-palm-tree-tj4o.onrender.com/api/v1/gateway
TEXTBEE_TIMEOUT_MS=10000
TEXTBEE_MAX_RETRIES=3

# El secret HMAC del webhook entrante NO es env: se deriva automáticamente
# de MASTER_ENCRYPTION_KEY_B64. Para obtenerlo y pegarlo en el dashboard del
# upstream (suscripción `signingSecret`), correr:
#   npx tsx scripts/print-webhook-secret.ts

# --- OTP ---
OTP_LENGTH=6
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_MESSAGE_TEMPLATE=Tu codigo es {{code}}. Expira en {{minutes}} min. No lo compartas.

# --- Rate limiting ---
RATE_LIMIT_IP_MAX=10
RATE_LIMIT_IP_WINDOW_SEC=3600
RATE_LIMIT_PHONE_DAILY_MAX=5
RATE_LIMIT_PHONE_COOLDOWN_SEC=60

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Phone validation ---
DEFAULT_PHONE_REGION=AR

# --- Worker ---
WORKER_CONCURRENCY=10
WORKER_MAX_RETRIES=3
WORKER_BACKOFF_MS=2000

# --- Circuit breaker ---
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_MS=30000

# --- Metrics ---
METRICS_ENABLED=true
METRICS_IP_ALLOWLIST=127.0.0.1,::1

# --- Base URL pública ---
# Usada al construir el link de acceso para el cliente.
# Ej: https://sms-gateway-api.onrender.com  o  http://localhost:3000
APP_BASE_URL=http://localhost:3000
